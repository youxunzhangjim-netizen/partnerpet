{
  "name": "transparent-pet-room",
  "version": "0.5.0",
  "description": "Transparent fullscreen desktop pet room with deployable Socket.IO bridge, accountless pairing, dual pets, state machine, and low-power optimization.",
  "author": "PartnerPets",
  "main": "main.js",
  "private": true,
  "scripts": {
    "start": "electron .",
    "electron-start": "electron main.js",
    "dev": "electron main.js --dev",
    "server": "npm --prefix server start",
    "server:root": "node server.js",
    "pack": "electron-builder --dir",
    "dist": "electron-builder --publish never",
    "dist:win": "electron-builder --win nsis --publish never",
    "dist:mac": "electron-builder --mac dmg --publish never",
    "dist:linux": "electron-builder --linux AppImage --publish never"
  },
  "dependencies": {
    "socket.io-client": "^4.8.3"
  },
  "devDependencies": {
    "electron": "^42.5.0",
    "electron-builder": "^26.15.3"
  },
  "build": {
    "appId": "com.partnerpets.desktop",
    "productName": "PartnerPets",
    "copyright": "Copyright (c) 2026 PartnerPets",
    "directories": {
      "output": "release"
    },
    "extraMetadata": {
      "main": "main.js"
    },
    "files": [
      "package.json",
      "main.js",
      "preload.js",
      "config.js",
      "index.html",
      "renderer.js",
      "assets/**/*",
      "node_modules/socket.io-client/dist/socket.io.min.js"
    ],
    "asar": true,
    "mac": {
      "target": [
        "dmg"
      ],
      "category": "public.app-category.entertainment"
    },
    "win": {
      "target": [
        "nsis"
      ]
    },
    "linux": {
      "target": [
        "AppImage"
      ],
      "category": "Utility"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true
    }
  }
}
